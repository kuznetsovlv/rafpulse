{
  "name": "rafpulse",
  "version": "0.0.0",
  "packageManager": "pnpm@11.1.2",
  "description": "A lightweight shared requestAnimationFrame loop for JavaScript",
  "main": "index.js",
  "keywords": [
    "requestAnimationFrame",
    "raf",
    "animation",
    "animation-frame",
    "frame-loop",
    "scheduler"
  ],
  "author": "Leonid Kuznetsov",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuznetsovlv/rafpulse.git"
  },
  "bugs": {
    "url": "https://github.com/kuznetsovlv/rafpulse/issues"
  },
  "homepage": "https://github.com/kuznetsovlv/rafpulse#readme",
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "prettier": "prettier . --write",
    "prettier:check": "prettier . --check",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "pnpm lint && pnpm prettier",
    "format:check": "pnpm prettier:check && pnpm lint:check",
    "typecheck": "tsc --noEmit",
    "pack:check": "pnpm pack --dry-run",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm coverage && pnpm build && pnpm pack:check",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm check && pnpm exec changeset publish"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
